DEF CAR Robot {
  translation 0 -1.75 1.4
  children [
    Camera {
      name "camera"
      width 1280
      height 720
      fieldOfView 1.0
      antiAliasing TRUE
    }
    Display {
      name "detector_view"
      width 768
      height 432
    }
    DEF HEADLIGHT SpotLight {
      attenuation 0 0 0.02
      beamWidth 0.5
      cutOffAngle 0.75
      direction 1 0 -0.12
      intensity 6
      location 0.5 0 -0.6
      radius 120
      on FALSE
    }
  ]
  name "CAR"
  controller "sign_drive"
  supervisor TRUE
}
